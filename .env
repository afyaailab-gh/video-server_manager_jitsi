# Server
PORT=3001
# Use "development" to skip token auth on every request (easier for local testing)
# Switch to "production" when deploying
NODE_ENV=production

# Jitsi Configuration
# For local testing this points at the public Jitsi server (meet.jit.si)
# Replace with your self-hosted domain once you have one running
JITSI_HOST=meet.jit.si
JITSI_PORT=443
JITSI_SUBJECT=meet.jit.si

# This secret must match the JWT_APP_SECRET in your Jitsi Docker .env
# (only required if you enable token-protected rooms on your self-hosted Jitsi)
JITSI_SECRET=49e3cbfdf3c3f06fcec9780232ae47c2dffe49240eadf5b36771b09b6857e682

# Enable JWT Token authentication (for self-hosted Jitsi)
ENABLE_AUTH=1
AUTH_TYPE=jwt

# JWT Configuration — used to sign/verify tokens issued by THIS API
JWT_SECRET=bee32cb30be4625dc10a784dfb92eae2ca0910d436eed70c97ff503a14068533
JWT_EXPIRY=24h

# Redis (optional — not required for in-memory meeting store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://afyaaicare.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging (debug | info | warn | error)
LOG_LEVEL=info

# Optional — only needed when using Jibri cloud recording
# JIBRI_URL=
# JIBRI_SECRET=

# Set to "true" in production to expose the /api/setup/* endpoints
ENABLE_SETUP=true
