{
  "name": "afyaai__meet_host",
  "version": "1.0.0",
  "description": "Self-hosted Jitsi Meet API for AfyaCare",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "setup:jitsi": "node scripts/setup-jitsi.js",
    "generate:secrets": "curl -X POST http://localhost:3001/api/setup/generate-secrets",
    "jitsi:env": "curl -X POST http://localhost:3001/api/setup/save-jitsi-env"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "generate-password": "^1.7.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "redis": "^4.6.8",
    "twilio": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
